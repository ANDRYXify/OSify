# ==============================================================================
# OSify Vintage Desktop Panel Configuration (Tint2)
# ==============================================================================
# Ottimizzato per risoluzione WSVGA 1024x600 (altezza pannello: 24px)
# Palette: Deep Obsidian (#0D0D14), Bordo Viola (#7C3AED), Testo Bianco/Menta
# ==============================================================================

# Background 1: Pannello Principale
rounded = 0
border_width = 1
border_sides = T
border_color = #7C3AED 80
background_color = #0D0D14 E6

# Background 2: Elemento Attivo (Finestra in primo piano)
rounded = 3
border_width = 1
border_sides = B
border_color = #10B981 FF
background_color = #1E1B4B CC

# Background 3: Elemento Inattivo (Finestre a riposo)
rounded = 3
border_width = 0
border_sides = 
border_color = #000000 00
background_color = #181824 99

# Posizionamento Pannello
panel_monitor = all
panel_position = bottom center horizontal
panel_size = 100% 24
panel_margin = 0 0
panel_padding = 4 2 4
panel_background_id = 1
wm_menu = 1
panel_dock = 0
panel_layer = top

# Ordine Elementi: Launcher, Finestre, Vassoio di Sistema, Batteria, Orologio
panel_items = LTSCB

# Launcher (Menu & Applicazioni Essenziali)
launcher_padding = 4 2
launcher_background_id = 0
launcher_icon_size = 18
launcher_item_app = /usr/share/applications/falkon.desktop
launcher_item_app = /usr/share/applications/pcmanfm-qt.desktop
launcher_item_app = /usr/share/applications/qterminal.desktop

# Barra delle Finestre (Taskbar)
taskbar_mode = single_desktop
taskbar_padding = 2 0 2
taskbar_background_id = 0
taskbar_active_background_id = 2
taskbar_name = 0
taskbar_hide_inactive_tasks = 0
taskbar_hide_different_monitor = 0
taskbar_always_show_all_desktop_tasks = 0

# Finestre Individuali (Task)
task_icon = 1
task_text = 1
task_maximum_size = 180 20
task_padding = 6 2
task_font = Inter 8
task_font_color = #94A3B8 100
task_active_font_color = #FFFFFF 100
task_background_id = 3
task_active_background_id = 2

# Vassoio di Sistema (Systray)
systray_padding = 4 2 4
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 16
systray_icon_as_icon = 1

# Indicatore Batteria (Essenziale per Netbook)
battery_padding = 4 2
battery_background_id = 0
battery_font = Inter 8
battery_font_color = #10B981 100
battery_format = %p%

# Orologio
time1_format = %H:%M
time1_font = Inter Bold 9
time1_font_color = #FFFFFF 100
clock_padding = 8 2
clock_background_id = 0
