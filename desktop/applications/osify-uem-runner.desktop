[Desktop Entry]
Version=1.0
Type=Application
Name=OSify Universal Runner
GenericName=Universal Binary Executor
Comment=Esegue in modo trasparente binari Windows PE, Android APK, WebAssembly, Java JAR, MS-DOS e Cross-ISA
Exec=/usr/bin/osify-exec %f
Icon=/usr/share/pixmaps/osify-games.png
Terminal=false
Categories=System;Utility;Emulator;
MimeType=application/x-msdos-program;application/x-msdownload;application/vnd.android.package-archive;application/wasm;application/java-archive;application/x-java-archive;application/x-executable;application/x-sharedlib;application/x-mach-binary;application/x-apple-diskimage;
StartupNotify=true
NoDisplay=false
