# OSify macOS Theme 2050 per Openbox
# Creato da Andrea Taliento (ANDRYXify)
# Design Traffic Lights (Rosso, Giallo, Verde) a sinistra e Titolo Finestra Centrato

# Bordi generali
border.width: 1
border.color: #27272a
padding.width: 4
padding.height: 4
window.handle.width: 0

# Finestra attiva
window.active.title.bg: flat solid #18181b
window.active.title.separator.color: #27272a
window.active.label.bg: parentrelative
window.active.label.text.color: #f4f4f5
window.active.label.text.justify: center
window.active.border.color: #3f3f46

# Finestra inattiva
window.inactive.title.bg: flat solid #0f0f12
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #71717a
window.inactive.label.text.justify: center
window.inactive.border.color: #18181b

# Bottoni attivi (Traffic Lights di macOS)
window.active.button.unpressed.bg: parentrelative
window.active.button.pressed.bg: parentrelative
window.active.button.hover.bg: parentrelative

# Rosso Chiudi
window.active.button.close.unpressed.image.color: #ff5f56
window.active.button.close.hover.image.color: #ff3b30
window.active.button.close.pressed.image.color: #e02424

# Giallo Riduci a Icona
window.active.button.iconify.unpressed.image.color: #ffbd2e
window.active.button.iconify.hover.image.color: #ff9500
window.active.button.iconify.pressed.image.color: #d97706

# Verde Massimizza
window.active.button.max.unpressed.image.color: #27c93f
window.active.button.max.hover.image.color: #34c759
window.active.button.max.pressed.image.color: #16a34a

# Bottoni inattivi (Grigio discreto elegante)
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.pressed.bg: parentrelative
window.inactive.button.hover.bg: parentrelative
window.inactive.button.close.unpressed.image.color: #3f3f46
window.inactive.button.iconify.unpressed.image.color: #3f3f46
window.inactive.button.max.unpressed.image.color: #3f3f46

# Menu a comparsa
menu.border.width: 1
menu.border.color: #27272a
menu.title.bg: flat solid #18181b
menu.title.text.color: #38bdf8
menu.title.text.justify: center
menu.items.bg: flat solid #0f111a
menu.items.text.color: #e2e8f0
menu.items.disabled.text.color: #64748b
menu.items.active.bg: flat solid #0284c7
menu.items.active.text.color: #ffffff

# OSD (Switch finestre Alt-Tab)
osd.border.width: 1
osd.border.color: #38bdf8
osd.bg: flat solid #0f111a
osd.label.bg: flat solid #0f111a
osd.label.text.color: #38bdf8
