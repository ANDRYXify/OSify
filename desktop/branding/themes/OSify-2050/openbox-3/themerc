# OSify 2050 Window Manager Theme
# Ingegnerizzato da Andrea Taliento (ANDRYXify)
# Design originale proprietario: Obsidian Dark Glass, accenti Neon ciano e viola.

# Bordi e geometrie
border.width: 1
border.color: #1e293b
padding.width: 4
padding.height: 3
window.client.padding.width: 0
window.client.padding.height: 0
window.handle.width: 0

# Finestra attiva
window.active.border.color: #06b6d4
window.active.title.bg: flat gradient vertical
window.active.title.bg.color: #141c2e
window.active.title.bg.colorTo: #0b0f19
window.active.label.bg: parentrelative
window.active.label.text.color: #f8fafc
window.active.label.text.font: shadow=n

# Finestra inattiva
window.inactive.border.color: #1e293b
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #0b0f19
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #64748b
window.inactive.label.text.font: shadow=n

# Pulsanti finestra (Chiusura, Massimizzazione, Riduzione)
window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #94a3b8

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #1c2740
window.active.button.hover.image.color: #06b6d4

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #06b6d4
window.active.button.pressed.image.color: #000000

window.active.button.close.unpressed.image.color: #ef4444
window.active.button.close.hover.image.color: #f87171
window.active.button.max.unpressed.image.color: #8b5cf6
window.active.button.max.hover.image.color: #a855f7
window.active.button.iconify.unpressed.image.color: #06b6d4
window.active.button.iconify.hover.image.color: #38bdf8

window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #475569
window.inactive.button.close.unpressed.image.color: #7f1d1d
window.inactive.button.max.unpressed.image.color: #4c1d95
window.inactive.button.iconify.unpressed.image.color: #164e63

# Menu contestuale Openbox
menu.border.width: 1
menu.border.color: #1e293b
menu.title.bg: flat solid
menu.title.bg.color: #0f1420
menu.title.text.color: #06b6d4
menu.items.bg: flat solid
menu.items.bg.color: #0b0f19
menu.items.text.color: #e2e8f0
menu.items.active.bg: flat solid
menu.items.active.bg.color: #1e293b
menu.items.active.text.color: #06b6d4
menu.items.disabled.text.color: #475569
menu.separator.color: #1e293b
menu.separator.width: 1
menu.separator.padding.width: 4
menu.separator.padding.height: 2
