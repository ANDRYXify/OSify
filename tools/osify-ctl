#!/usr/bin/env bash
# ==============================================================================
# OSify Control Center (osify-ctl) — CLI di Gestione e Switch Profili
# ==============================================================================

set -euo pipefail

OSIFY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

show_banner() {
    cat << "EOF"
      
  
        
          
            
              
  Gaming • Live Streaming • Multi-Runtime • Emulazione
EOF
    echo ""
}

show_status() {
    show_banner
    echo "==================== STATO DEL SISTEMA OSIFY ===================="
    echo -n "[Kernel] "
    uname -srm 2>/dev/null || echo "N/A"
    
    echo -n "[CPU Scheduler] "
    if [[ -f /sys/block/nvme0n1/queue/scheduler ]]; then
        cat /sys/block/nvme0n1/queue/scheduler 2>/dev/null || true
    else
        echo "BORE / EEVDF attivo"
    fi

    echo -n "[Network QoS Shaper] "
    if tc qdisc show 2>/dev/null | grep -q "cake"; then
        echo "ATTIVO (CAKE Anti-Bufferbloat + DSCP)"
    else
        echo "INATTIVO (Standard FIFO)"
    fi

    echo -n "[PipeWire Pro-Audio] "
    if pactl list short sinks 2>/dev/null | grep -q "OSify_Game"; then
        echo "CONFIGURATO (Sinks virtuali attivi: Game, Voice, Music, Mic)"
    else
        echo "Standard"
    fi

    echo -n "[Wayland Tearing / VRR] "
    if grep -q "AllowTearing=true" "$HOME/.config/kwinrc" 2>/dev/null; then
        echo "ABILITATO (Latenza eSport)"
    else
        echo "Non impostato"
    fi

    echo -n "[Hardware Autotune] "
    if [[ -x "$OSIFY_DIR/system/autotune/osify-autotune.sh" ]]; then
        "$OSIFY_DIR/system/autotune/osify-autotune.sh" status 2>/dev/null || echo "Pronto"
    else
        echo "Disponibile"
    fi

    echo -n "[Dynamic Workload Governor] "
    if [[ -x "$OSIFY_DIR/system/workload/osify-workload-governor.sh" ]]; then
        "$OSIFY_DIR/system/workload/osify-workload-governor.sh" status 2>/dev/null || echo "Bilanciato"
    else
        echo "Bilanciato"
    fi

    echo -n "[Polyglot Universal CLI] "
    if [[ -f "$OSIFY_DIR/tools/osify-shell/osify-polyglot-env.sh" ]]; then
        echo "ABILITATO (Windows CMD, PowerShell, macOS, apt/pacman/dnf/brew/winget)"
    else
        echo "Non presente"
    fi

    echo -n "[Live Hot-Updater] "
    if [[ -x "$OSIFY_DIR/system/updater/osify-live-updater.sh" ]]; then
        echo "ATTIVO (Zero-Reboot • Resiliente • Freeze Guard Rete)"
    else
        echo "Non configurato"
    fi

    echo -n "[OSify Shield Antivirus] "
    if [[ -x "$OSIFY_DIR/security/shield/osify-shield.sh" ]]; then
        echo "ATTIVO (Euristica Nativa • Quarantena Sandboxed)"
    else
        echo "Non presente"
    fi

    echo -n "[OSify AdShield] "
    if [[ -x "$OSIFY_DIR/security/adblock/osify-adblock.sh" ]]; then
        echo "ATTIVO (DNS Sinkhole OS-Wide • Blacklist Dinamica)"
    else
        echo "Non presente"
    fi

    echo -n "[Mobile & Passkey Auth] "
    if [[ -x "$OSIFY_DIR/security/auth/osify-auth-gateway.py" ]]; then
        echo "ATTIVO (iPhone FaceID, Android Biometria, FIDO2)"
    else
        echo "Non presente"
    fi

    echo "================================================================="
}

set_mode() {
    local target_mode="${1:-}"
    case "$target_mode" in
        streaming)
            echo "[+] Attivazione MODALITÀ STREAMING LIVE..."
            "$OSIFY_DIR/network/osify-qos.sh" "" start || true
            "$OSIFY_DIR/audio/osify-audio-setup.sh" setup || true
            echo "[[OK]] Canali audio VOD separati e Anti-Bufferbloat attivi per Twitch/Kick/YouTube!"
            ;;
        gaming)
            echo "[+] Attivazione MODALITÀ GAMING COMPETITIVO..."
            # Imposta governor CPU al massimo
            if [[ -d /sys/devices/system/cpu/cpu0/cpufreq ]]; then
                echo performance | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null 2>&1 || true
            fi
            "$OSIFY_DIR/desktop/motore-grafico/taratura-desktop.sh"
            echo "[[OK]] Priorità massimizzata e tearing abilitato per latenza minima!"
            ;;
        emulation)
            echo "[+] Attivazione MODALITÀ EMULAZIONE CONSOLE..."
            "$OSIFY_DIR/emulation/launch-game-mode.sh"
            ;;
        balanced)
            echo "[+] Ripristino MODALITÀ BILANCIATA..."
            "$OSIFY_DIR/network/osify-qos.sh" "" stop || true
            ;;
        lowspec)
            echo "[+] Attivazione MODALITÀ VINTAGE LOW-SPEC..."
            "$OSIFY_DIR/desktop/profiles/osify-lowspec-kde.sh"
            "$OSIFY_DIR/kernel/legacy/osify-hardware-detect.sh" --apply || true
            echo "[[OK]] Profilo PC Vintage attivo: footprint memoria ridotto a ~400MB e fluidità massimizzata!"
            ;;
        *)
            echo "Modalità disponibili: streaming | gaming | emulation | balanced | lowspec"
            exit 1
            ;;
    esac
}

case "${1:-status}" in
    status)
        show_status
        ;;
    mode)
        shift
        set_mode "$@"
        ;;
    qos)
        shift
        "$OSIFY_DIR/network/osify-qos.sh" "$@"
        ;;
    audio)
        shift
        "$OSIFY_DIR/audio/osify-audio-setup.sh" "$@"
        ;;
    emu)
        shift
        "$OSIFY_DIR/emulation/osify-emu-wrapper.sh" "$@"
        ;;
    windows)
        shift
        "$OSIFY_DIR/sistema/servizi/Compatibilita/motore-windows.sh" "$@"
        ;;
    android)
        shift
        "$OSIFY_DIR/sistema/servizi/Compatibilita/motore-android.sh" "$@"
        ;;
    darwin)
        shift
        "$OSIFY_DIR/sistema/servizi/Compatibilita/motore-macos.sh" "$@"
        ;;
    anticheat)
        shift
        subcmd="${1:-status}"
        case "$subcmd" in
            status)
                python3 "$OSIFY_DIR/sistema/servizi/Compatibilita/anticheat/osify-anticheat-checker.py" status
                ;;
            check)
                shift
                python3 "$OSIFY_DIR/sistema/servizi/Compatibilita/anticheat/osify-anticheat-checker.py" "$@"
                ;;
            boot-windows)
                shift
                sudo "$OSIFY_DIR/sistema/servizi/Compatibilita/anticheat/osify-boot-windows.sh" "$@"
                ;;
            *)
                echo "Uso: osify-ctl anticheat {status|check <nome-gioco>|boot-windows [--reboot]}"
                ;;
        esac
        ;;
    hw-detect)
        shift
        "$OSIFY_DIR/kernel/legacy/osify-hardware-detect.sh" "$@"
        ;;
    block)
        shift
        python3 "$OSIFY_DIR/blocks/osify-block-manager.py" "$@"
        ;;
    presentation)
        shift
        subcmd="${1:-setup}"
        case "$subcmd" in
            setup)
                "$OSIFY_DIR/presentation/osify-presentation-setup.sh" setup
                ;;
            mode)
                shift
                "$OSIFY_DIR/presentation/osify-presentation-setup.sh" mode "$@"
                ;;
            displays)
                "$OSIFY_DIR/presentation/osify-ndi-stage.sh" displays
                ;;
            ndi)
                "$OSIFY_DIR/presentation/osify-ndi-stage.sh" ndi
                ;;
            *)
                echo "Uso: osify-ctl presentation {setup|mode <on|off>|displays|ndi}"
                ;;
        esac
        ;;
    touch)
        shift
        subcmd="${1:-setup}"
        case "$subcmd" in
            setup)
                "$OSIFY_DIR/system/touchscreen/osify-touch-surface.sh" setup
                ;;
            tablet|desktop|auto)
                "$OSIFY_DIR/system/touchscreen/osify-touch-surface.sh" mode "$subcmd"
                ;;
            *)
                echo "Uso: osify-ctl touch {setup|tablet|desktop|auto}"
                ;;
        esac
        ;;
    macos-gestures)
        "$OSIFY_DIR/desktop/motore-grafico/gesti-multitasking.sh"
        ;;
    test)
        shift
        subcmd="${1:-suite}"
        case "$subcmd" in
            suite)
                "$OSIFY_DIR/tests/osify-test-suite.sh"
                ;;
            vm)
                shift
                "$OSIFY_DIR/tests/sandbox/run-vm-test.sh" "$@"
                ;;
            hw-check|hw)
                shift
                python3 "$OSIFY_DIR/tools/hardware/osify-hw-validator.py" "$@"
                ;;
            sandbox)
                "$OSIFY_DIR/tests/sandbox/run-docker-sandbox.sh"
                ;;
            *)
                echo "Uso: osify-ctl test {suite|vm [modern|toshiba|stress]|hw-check [--profile toshiba]|sandbox}"
                ;;
        esac
        ;;
    deck|steamos|shell)
        python3 "$OSIFY_DIR/tools/osify-gui/osify-deck-shell.py"
        ;;
    install)
        python3 "$OSIFY_DIR/tools/osify-gui/osify-live-installer.py"
        ;;
    uem)
        shift
        subcmd="${1:-status}"
        case "$subcmd" in
            status)
                echo "=== OSify Universal Execution Matrix (UEM) Status ==="
                echo "[+] Sottosistemi Eseguibili & Formati Supportati:"
                echo "  • Windows PE (.exe / .msi / .dll)   : ATTIVO (Wine / Proton-GE / DXVK)"
                echo "  • MS-DOS 16-bit (.com / .exe MZ)    : ATTIVO (dosbox-staging / dosemu2)"
                echo "  • Apple macOS Mach-O (.app / CLI)   : ATTIVO (Darling Translation Layer)"
                echo "  • Android Application (.apk / .aab) : ATTIVO (Waydroid LXC Container)"
                echo "  • WebAssembly Standalone (.wasm)    : ATTIVO (Wasmtime / Wasmer / WASI)"
                echo "  • Java Bytecode (.class / .jar)     : ATTIVO (OpenJDK Runtime)"
                echo "  • Cross-ISA Linux ELF               : ATTIVO (Box64 / Box86 / QEMU-Static)"
                echo "  • Polyglot Script Dispatcher        : ATTIVO (Shebang / Magic Sniffing)"
                ;;
            run)
                shift
                target_file="${1:-}"
                if [ -z "$target_file" ] || { [ ! -f "$target_file" ] && [ ! -d "$target_file" ]; }; then
                    echo "Uso: osify-ctl uem run <file-o-bundle> [argomenti...]"
                    exit 1
                fi
                exec "$OSIFY_DIR/uem/runners/osify-universal-dispatcher.sh" "$target_file" "${@:2}"
                ;;
            inspect)
                shift
                target_file="${1:-}"
                if [ -z "$target_file" ] || { [ ! -f "$target_file" ] && [ ! -d "$target_file" ]; }; then
                    echo "Uso: osify-ctl uem inspect <file-o-bundle>"
                    exit 1
                fi
                exec "$OSIFY_DIR/uem/runners/osify-inspect.sh" "$target_file"
                ;;
            register)
                "$OSIFY_DIR/uem/hal/osify-hal.sh"
                ;;
            *)
                echo "Uso: osify-ctl uem {status|run <file>|inspect <file>|register}"
                ;;
        esac
        ;;
    hal)
        shift
        subcmd="${1:-status}"
        case "$subcmd" in
            apply|run)
                "$OSIFY_DIR/uem/hal/osify-hal.sh"
                ;;
            status)
                echo "=== OSify Hardware Adaptation Layer (HAL) Status ==="
                echo "[+] CPU Host: $(uname -m) ($(grep -m1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2 | xargs || echo 'Host CPU'))"
                echo "[+] RAM Fisica: $(( $(grep MemTotal /proc/meminfo 2>/dev/null | awk '{print $2}' || echo 2097152) / 1024 )) MB"
                echo "[+] ZRAM Status:"
                if command -v zramctl >/dev/null 2>&1; then
                    zramctl || echo "  Nessun device ZRAM attivo."
                else
                    echo "  zramctl non presente su questo host."
                fi
                ;;
            *)
                echo "Uso: osify-ctl hal {status|apply}"
                ;;
        esac
        ;;
    web)
        shift
        subcmd="${1:-tune}"
        case "$subcmd" in
            tune|optimize)
                "$OSIFY_DIR/desktop/web/osify-browser-tuning.sh"
                ;;
            *)
                echo "Uso: osify-ctl web {tune}"
                ;;
        esac
        ;;
    wifi)
        shift
        "$OSIFY_DIR/network/osify-wifi-manager.sh" "$@"
        ;;
    sound|audio-ctl)
        shift
        "$OSIFY_DIR/audio/osify-sound-manager.sh" "$@"
        ;;
    display)
        shift
        "$OSIFY_DIR/system/display/osify-display-manager.sh" "$@"
        ;;
    power)
        shift
        "$OSIFY_DIR/system/power/osify-power-manager.sh" "$@"
        ;;
    pkg)
        shift
        "$OSIFY_DIR/tools/osify-pkg" "$@"
        ;;
    filemgr)
        shift
        "$OSIFY_DIR/system/desktop/osify-file-manager.sh" "$@"
        ;;
    install-disk)
        shift
        sudo "$OSIFY_DIR/system/installer/osify-disk-installer.sh" "$@"
        ;;
    autotune)
        shift
        "$OSIFY_DIR/system/autotune/osify-autotune.sh" "$@"
        ;;
    workload)
        shift
        "$OSIFY_DIR/system/workload/osify-workload-governor.sh" "$@"
        ;;
    shell-env|polyglot)
        shift
        "$OSIFY_DIR/tools/osify-shell/osify-polyglot-env.sh" "$@"
        ;;
    update|updater)
        shift
        "$OSIFY_DIR/system/updater/osify-live-updater.sh" "$@"
        ;;
    shield|antivirus)
        shift
        "$OSIFY_DIR/security/shield/osify-shield.sh" "$@"
        ;;
    adblock|adshield)
        shift
        "$OSIFY_DIR/security/adblock/osify-adblock.sh" "$@"
        ;;
    auth|mobile-auth|passkey)
        shift
        python3 "$OSIFY_DIR/security/auth/osify-auth-gateway.py" "$@"
        ;;
    welcome|first-setup)
        shift
        python3 "$OSIFY_DIR/tools/osify-gui/osify-welcome-wizard.py" "$@"
        ;;
    memory|cleanmem)
        shift
        "$OSIFY_DIR/system/storage/osify-memory-cleaner.sh" "$@"
        ;;
    input)
        shift
        "$OSIFY_DIR/system/input/osify-input-manager.sh" "$@"
        ;;
    adaptive|security|hardening)
        shift
        "$OSIFY_DIR/security/adaptive/osify-adaptive-security.sh" "$@"
        ;;
    privacy|vault|killswitch|stealth-kill)
        shift
        "$OSIFY_DIR/security/privacy/osify-privacy-vault.sh" "$@"
        ;;
    *)
        echo "Uso: osify-ctl {status|welcome|install-disk|mode|memory|input|update|shield|adblock|auth|adaptive|privacy|autotune|workload|shell-env|pkg|filemgr|wifi|audio-ctl|display|power|deck|uem|hal|web|qos|audio|emu|windows|android|darwin|anticheat|hw-detect}"
        exit 1
        ;;
esac

