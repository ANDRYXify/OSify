    bluetooth|bt)
        shift
        [ -x /usr/bin/osify-bluetooth ] && exec /usr/bin/osify-bluetooth "$@" || echo "Modulo bluetooth non disponibile"
        ;;
    snapshot|ripristino|backup)
        shift
        [ -x /usr/bin/osify-snapshot ] && exec /usr/bin/osify-snapshot "$@" || echo "Modulo snapshot non disponibile"
        ;;
    net-check|diagnostica|ping)
        shift
        [ -x /usr/bin/osify-net-check ] && exec /usr/bin/osify-net-check "$@" || echo "Modulo diagnostica rete non disponibile"
        ;;
    sicurezza|security|shield)
        shift
        [ -x /usr/bin/osify-adaptive-security ] && exec /usr/bin/osify-adaptive-security "$@" || [ -x /usr/bin/osify-shield ] && exec /usr/bin/osify-shield "$@" || echo "Modulo sicurezza non disponibile"
        ;;
    privacy|vault)
        shift
        [ -x /usr/bin/osify-privacy-vault ] && exec /usr/bin/osify-privacy-vault "$@" || echo "Modulo privacy non disponibile"
        ;;
    stealth|killswitch|panic)
        shift
        [ -x /usr/bin/osify-privacy-vault ] && exec /usr/bin/osify-privacy-vault killswitch "$@" || echo "Kill-Switch non disponibile"
        ;;
    shred)
        shift
        [ -x /usr/bin/osify-privacy-vault ] && exec /usr/bin/osify-privacy-vault shred "$@" || echo "Shredder non disponibile"
        ;;
    automount)
        shift
        [ -x /usr/bin/osify-automount ] && exec /usr/bin/osify-automount "$@" || echo "Modulo automount non disponibile"
        ;;
    aiuto|help|-h|--help)
        cmd_aiuto
        ;;
    "")
        # Se siamo in un terminale interattivo, lancia la Dashboard TUI a 360°
        if [ -t 0 ]; then
            cmd_dashboard
        else
            cmd_info
        fi
        ;;
    *)
        echo "${C_RED}Comando '$1' non riconosciuto.${C_RESET}"
        echo "Digita ${C_CYAN}osify aiuto${C_RESET} per la lista dei comandi o semplicemente ${C_CYAN}osify${C_RESET} per la Dashboard."
        exit 1
        ;;
esac
