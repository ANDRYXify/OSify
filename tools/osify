# Rilevamento metriche hardware in tempo reale
detect_metrics() {
    CPU_MODEL=$(awk -F: '/model name/ {print $2; exit}' /proc/cpuinfo 2>/dev/null | sed 's/^[ \t]*//')
    [ -z "$CPU_MODEL" ] && CPU_MODEL="$(uname -m)"
    CPU_CORES=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo 1)
    
    RAM_TOTAL_KB=$(awk '/MemTotal/ {print $2}' /proc/meminfo 2>/dev/null || echo 1048576)
    RAM_AVAIL_KB=$(awk '/MemAvailable/ {print $2}' /proc/meminfo 2>/dev/null || awk '/MemFree/ {print $2}' /proc/meminfo 2>/dev/null || echo 524288)
    RAM_USED_KB=$((RAM_TOTAL_KB - RAM_AVAIL_KB))
    
    RAM_TOTAL_MB=$((RAM_TOTAL_KB / 1024))
    RAM_USED_MB=$((RAM_USED_KB / 1024))
    RAM_PERCENT=$((RAM_USED_KB * 100 / RAM_TOTAL_KB))
    
    # Barra grafica Unicode RAM (10 blocchi)
    BAR_TOTAL=10
    BAR_FILLED=$((RAM_PERCENT * BAR_TOTAL / 100))
    [ "$BAR_FILLED" -lt 1 ] && BAR_FILLED=1
    [ "$BAR_FILLED" -gt 10 ] && BAR_FILLED=10
    
    RAM_BAR=""
    _i=0
    while [ "$_i" -lt "$BAR_FILLED" ]; do
        RAM_BAR="${RAM_BAR}■"
        _i=$((_i + 1))
    done
    while [ "$_i" -lt "$BAR_TOTAL" ]; do
        RAM_BAR="${RAM_BAR}□"
        _i=$((_i + 1))
    done

    # zRAM
    ZRAM_INFO="Non attiva"
    if [ -b /dev/zram0 ]; then
        _zsize=$(awk '/zram0/ {print int($3/1024)" MB"}' /proc/swaps 2>/dev/null || echo "")
        [ -n "$_zsize" ] && ZRAM_INFO="Attiva ($_zsize LZ4)"
    fi

    # Batteria
    BAT_STATUS="Alimentatore AC"
    for b in /sys/class/power_supply/BAT*; do
        if [ -d "$b" ]; then
            _cap=$(cat "$b/capacity" 2>/dev/null || echo "")
            _stat=$(cat "$b/status" 2>/dev/null || echo "")
            [ -n "$_cap" ] && BAT_STATUS="${_cap}% ($_stat)"
            break
        fi
    done

    # Display e Risoluzione
    RES_INFO=$(xrandr 2>/dev/null | grep '\*' | awk '{print $1}' | head -n1 || echo "1024x600")

    # Wi-Fi
    WIFI_SSID="Disconnesso"
    if command -v iwgetid >/dev/null 2>&1; then
        _s=$(iwgetid -r 2>/dev/null || echo "")
        [ -n "$_s" ] && WIFI_SSID="$_s"
    elif [ -f /proc/net/wireless ]; then
        _if=$(awk 'NR==3 {print $1}' /proc/net/wireless | tr -d ':')
        [ -n "$_if" ] && WIFI_SSID="Collegato ($_if)"
    fi

    # Profilo Prestazioni
    PERF_MODE="Bilanciato"
    if grep -q "performance" /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null; then
        PERF_MODE="Turbo Performance (1.66GHz Max)"
    elif grep -q "powersave" /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null; then
        PERF_MODE="Eco Batteria (Risparmio Energetico)"
    fi
}

