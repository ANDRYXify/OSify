# Funzione: Dashboard Interattiva a Navigazione Fluida (Lanciata da 'osify' senza argomenti)
cmd_dashboard() {
    # Se è presente un server grafico X11, apri direttamente il Centro di Controllo GUI nativo
    if [ -n "${DISPLAY:-}" ]; then
        if [ -x /usr/bin/osify-hub ]; then
            exec /usr/bin/osify-hub
        elif [ -x /usr/bin/osify-app-drawer ]; then
            exec /usr/bin/osify-app-drawer
        fi
    fi

    local options=(
        "Tutte le Applicazioni Native (.ify)"
        "Modalita Prestazioni Turbo (1.66GHz & zRAM)"
        "Modalita Eco Risparmio Batteria"
        "Pulizia e Compattazione Memoria RAM"
        "Gestione Connessioni Wi-Fi"
        "Schermo e Risoluzioni Display"
        "Hub Giochi ed Emulazione"
        "Acquisizione Video Schermo/HDMI"
        "Integrazione Smartphone USB"
        "Gestione Audio e Volumi"
        "Dischi e Rimozione Sicura"
        "Installa OSify su Disco Fisso"
        "Profilo Utente e Multiutenza"
        "Controllo Aggiornamenti Sistema"
        "Menu Alimentazione e Sessione"
        "Esci al Prompt Shell"
    )

    local cur=0
    local count=${#options[@]}
    local key

    # Nascondi cursore del terminale
    printf "\033[?25l" 2>/dev/null || true
    trap 'printf "\033[?25h" 2>/dev/null || true' EXIT INT TERM

    while true; do
        clear
        detect_metrics
        print_logo
        echo ""
        echo "${C_GREEN}$(get_saluto)${C_RESET}"
        echo "${C_BOLD}======================= CENTRO DI CONTROLLO INTERATTIVO =======================${C_RESET}"
        echo " ${C_CYAN}CPU:${C_RESET} $CPU_MODEL ($CPU_CORES Core)   ${C_CYAN}RAM:${C_RESET} ${RAM_USED_MB}MB / ${RAM_TOTAL_MB}MB [${RAM_BAR}] ${RAM_PERCENT}%"
        echo " ${C_CYAN}Profilo:${C_RESET} $PERF_MODE   ${C_CYAN}zRAM:${C_RESET} $ZRAM_INFO   ${C_CYAN}Risoluzione:${C_RESET} $RES_INFO"
        echo " ${C_CYAN}Wi-Fi:${C_RESET} $WIFI_SSID   ${C_CYAN}Batteria:${C_RESET} $BAT_STATUS"
        echo "${C_BOLD}-------------------------------------------------------------------------------${C_RESET}"
        echo "${C_WHITE} Usa i tasti freccia [▲ / ▼] per navigare, [Invio] per eseguire, [Q] per uscire${C_RESET}"
        echo ""

        for i in "${!options[@]}"; do
            if [ "$i" -eq "$cur" ]; then
                printf "  ${C_BG_BLUE}${C_WHITE}${C_BOLD} ➔ %-72s ${C_RESET}\n" "${options[$i]}"
            else
                printf "     ${C_WHITE}%-72s${C_RESET}\n" "${options[$i]}"
            fi
        done
        echo "${C_BOLD}===============================================================================${C_RESET}"

        IFS= read -rsn1 key 2>/dev/null || break
        if [ "$key" = $'\x1b' ]; then
            read -rsn2 -t 0.1 rest 2>/dev/null || true
            case "$rest" in
                '[A') # Freccia Su
                    if [ "$cur" -gt 0 ]; then
                        cur=$((cur - 1))
                    else
                        cur=$((count - 1))
                    fi
                    ;;
                '[B') # Freccia Giu
                    if [ "$cur" -lt $((count - 1)) ]; then
                        cur=$((cur + 1))
                    else
                        cur=0
                    fi
                    ;;
            esac
        elif [ "$key" = "" ]; then
            # Invio premuto: esegui l'opzione selezionata
            printf "\033[?25h" 2>/dev/null || true
            case "$cur" in
                0)
                    [ -x /usr/bin/osify-app-drawer ] && /usr/bin/osify-app-drawer &
                    break
                    ;;
                1)
                    cmd_turbo
                    printf "\nPremi INVIO per continuare..."
                    read -r _dummy
                    ;;
                2)
                    cmd_eco
                    printf "\nPremi INVIO per continuare..."
                    read -r _dummy
                    ;;
                3)
                    cmd_pulisci
                    printf "\nPremi INVIO per continuare..."
                    read -r _dummy
                    ;;
                4)
                    [ -x /usr/bin/osify-wifi ] && /usr/bin/osify-wifi || true
                    printf "\nPremi INVIO per continuare..."
                    read -r _dummy
                    ;;
                5)
                    echo ""
                    echo "➔ Risoluzione Nativa 1024x600"
                    echo "➔ Virtual Scaler HD 1280x768"
                    echo "➔ Uscita Esterna Solo HDMI/TV"
                    cmd_schermo 1024x600
                    printf "\nPremi INVIO per continuare..."
                    read -r _dummy
                    ;;
                6)
                    [ -x /usr/bin/osify-games ] && /usr/bin/osify-games &
                    break
                    ;;
                7)
                    [ -x /usr/bin/osify-capture ] && /usr/bin/osify-capture &
                    break
                    ;;
                8)
                    [ -x /usr/bin/osify-phone ] && /usr/bin/osify-phone &
                    break
                    ;;
                9)
                    echo ""
                    /usr/bin/osify-sound-manager test 2>/dev/null || true
                    printf "\nPremi INVIO per continuare..."
                    read -r _dummy
                    ;;
                10)
                    [ -x /usr/bin/osify-storage-governor ] && /usr/bin/osify-storage-governor --status || true
                    printf "\nPremi INVIO per continuare..."
                    read -r _dummy
                    ;;
                11)
                    [ -x /usr/bin/osify-install ] && /usr/bin/osify-install &
                    break
                    ;;
                12)
                    [ -x /usr/bin/osify-profile-setup ] && /usr/bin/osify-profile-setup --force &
                    break
                    ;;
                13)
                    [ -x /usr/bin/osify-update ] && /usr/bin/osify-update || true
                    printf "\nPremi INVIO per continuare..."
                    read -r _dummy
                    ;;
                14)
                    [ -x /usr/bin/osify-power ] && /usr/bin/osify-power || true
                    break
                    ;;
                15)
                    clear
                    break
                    ;;
            esac
            printf "\033[?25l" 2>/dev/null || true
        elif [ "$key" = "q" ] || [ "$key" = "Q" ]; then
            printf "\033[?25h" 2>/dev/null || true
            clear
            break
        fi
    done
    printf "\033[?25h" 2>/dev/null || true
}

