    info|status|stato)
        cmd_info
        ;;
    turbo|boost|performance)
        cmd_turbo
        ;;
    eco|batteria|battery|powersave)
        cmd_eco
        ;;
    pulisci|clean|cleanmem|mem)
        cmd_pulisci
        ;;
    wifi|rete|network)
        shift
        [ -x /usr/bin/osify-wifi ] && exec /usr/bin/osify-wifi "$@" || echo "Modulo wifi non trovato"
        ;;
    schermo|display|video)
        shift
        cmd_schermo "$@"
        ;;
    app|cerca|drawer)
        shift
        [ -x /usr/bin/osify-app-drawer ] && exec /usr/bin/osify-app-drawer "$@" || true
        ;;
    installa|install|installer)
        shift
        [ -x /usr/bin/osify-install ] && exec /usr/bin/osify-install "$@" || true
