# Funzione: Turbo Performance
cmd_turbo() {
    echo "${C_CYAN}[+] Attivazione Modalità Turbo Performance OSify...${C_RESET}"
    for gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -f "$gov" ] && echo "performance" > "$gov" 2>/dev/null || true
    done
    modprobe -q zram 2>/dev/null || true
    if [ -b /dev/zram0 ]; then
        echo lz4 > /sys/block/zram0/comp_algorithm 2>/dev/null || echo lzo > /sys/block/zram0/comp_algorithm 2>/dev/null || true
        echo 1073741824 > /sys/block/zram0/disksize 2>/dev/null || echo 1G > /sys/block/zram0/disksize 2>/dev/null || true
        mkswap /dev/zram0 >/dev/null 2>&1 || true
        swapon -p 100 /dev/zram0 2>/dev/null || true
        sysctl -w vm.swappiness=70 vm.vfs_cache_pressure=50 >/dev/null 2>&1 || true
    fi
    sync && echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
    echo "${C_GREEN}[✓] CPU impostata a frequenza massima fissa!${C_RESET}"
    echo "${C_GREEN}[✓] zRAM Swap compresso ultra-rapido LZ4 attivo!${C_RESET}"
    echo "${C_GREEN}[✓] Cache RAM ottimizzata a latenza zero.${C_RESET}"
}

# Funzione: Risparmio Energetico Eco
cmd_eco() {
    echo "${C_CYAN}[+] Attivazione Modalità Risparmio Energetico Eco...${C_RESET}"
    for gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -f "$gov" ] && echo "powersave" > "$gov" 2>/dev/null || true
    done
    echo "${C_GREEN}[✓] Governor impostato su powersave per massima autonomia batteria!${C_RESET}"
}

# Funzione: Pulizia Memoria Istantanea
cmd_pulisci() {
    echo "${C_CYAN}[+] Pulizia Memoria RAM e Cache di Sistema...${C_RESET}"
    _before=$(awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)
    sync
    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
    if [ -x /usr/bin/osify-cleanmem ]; then
        /usr/bin/osify-cleanmem 2>/dev/null || true
    fi
    _after=$(awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)
    _liberati=$((_after - _before))
    [ "$_liberati" -lt 0 ] && _liberati=0
    echo "${C_GREEN}[✓] Memoria ripulita con successo! Liberati ${_liberati} MB di RAM.${C_RESET}"
    echo "RAM Libera Attuale: ${_after} MB"
}

# Funzione: Gestione Schermo e Risoluzioni
cmd_schermo() {
    _mode="$1"
    case "$_mode" in
        "1024x600"|"nativo"|"default")
            xrandr --output LVDS1 --scale 1x1 --panning 1024x600 2>/dev/null || xrandr -s 1024x600 2>/dev/null || true
            echo "${C_GREEN}[✓] Schermo reimpostato alla risoluzione nativa 1024x600.${C_RESET}"
            ;;
        "1280x768"|"scale"|"virtuale")
            xrandr --output LVDS1 --scale 1.25x1.28 --panning 1280x768 2>/dev/null || true
            echo "${C_GREEN}[✓] Virtual Scaler HD 1280x768 attivato! Tutte le finestre grandi ora entrano perfettamente nello schermo.${C_RESET}"
            ;;
        "hdmi"|"tv")
            xrandr --output HDMI1 --auto --primary --output LVDS1 --off 2>/dev/null || true
            echo "${C_GREEN}[✓] Uscita video commutata su porta HDMI (Monitor Esterno / TV).${C_RESET}"
            ;;
        "clona"|"mirror")
            xrandr --output HDMI1 --auto --same-as LVDS1 2>/dev/null || true
            echo "${C_GREEN}[✓] Uscite video duplicate (Display Netbook + HDMI Esterno).${C_RESET}"
            ;;
        "estendi")
            xrandr --output HDMI1 --auto --right-of LVDS1 2>/dev/null || true
            echo "${C_GREEN}[✓] Desktop esteso su monitor secondario (a destra).${C_RESET}"
            ;;
        *)
            echo "${C_YELLOW}Uso: osify schermo [1024x600 | 1280x768 | hdmi | clona | estendi]${C_RESET}"
            echo "Esempio: ${C_WHITE}osify schermo 1280x768${C_RESET} per attivare il virtual scaler."
            ;;
    esac
}

